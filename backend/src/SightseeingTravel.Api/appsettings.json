{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SightseeingTravel.Api",
    "Audience": "SightseeingTravel.Clients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "ContaboStorage": {
    "ServiceUrl": "https://sin1.contabostorage.com",
    "BucketName": "sightseeing-media",
    "PublicBaseUrl": "https://sin1.contabostorage.com/contabo-tenant-id:sightseeing-media",
    "AccessKey": "CONTABO_S3_ACCESS_KEY",
    "SecretKey": "CONTABO_S3_SECRET_KEY",
    "ForcePathStyle": true
  }
}
