    <EmbeddedResource Include="Migrations/0005_ArModelCatalogMetadata.sql" />
    <EmbeddedResource Include="Migrations/0006_IdentityPasswordReset.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SightseeingTravel.SharedKernel\SightseeingTravel.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Identity\SightseeingTravel.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Attractions\SightseeingTravel.Modules.Attractions.csproj" />
    <ProjectReference Include="..\Modules\ArExperience\SightseeingTravel.Modules.ArExperience.csproj" />
    <ProjectReference Include="..\Modules\CommunityMedia\SightseeingTravel.Modules.CommunityMedia.csproj" />
  </ItemGroup>

</Project>
