# PostgreSQL Configuration (Contabo VPS)
POSTGRES_DB=sightseeing_travel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_postgres_password

# Self-Hosted JWT Configuration
JWT_ISSUER=SightseeingTravel.Api
JWT_AUDIENCE=SightseeingTravel.Clients
JWT_SIGNING_KEY=SightseeingTravel_SuperSecret_JwtSigningKey_2026_Minimum32Bytes!

# Contabo Object Storage (S3-Compatible API)
CONTABO_S3_SERVICE_URL=https://sin1.contabostorage.com
CONTABO_S3_BUCKET_NAME=sightseeing-media
CONTABO_S3_PUBLIC_BASE_URL=https://sin1.contabostorage.com/your-contabo-tenant-id:sightseeing-media
CONTABO_S3_ACCESS_KEY=your_contabo_s3_access_key
CONTABO_S3_SECRET_KEY=your_contabo_s3_secret_key
