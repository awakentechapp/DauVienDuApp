# Existing FlashPanel PostgreSQL on the Contabo VPS
POSTGRES_DB=awkdvd
POSTGRES_USER=awkdvd
POSTGRES_PASSWORD=

# Self-hosted JWT configuration
JWT_ISSUER=SightseeingTravel.Api
JWT_AUDIENCE=SightseeingTravel.Clients
JWT_SIGNING_KEY=

# Required once if the database has no SuperAdmin; remove the password after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Contabo Object Storage (S3-compatible API)
CONTABO_S3_SERVICE_URL=https://sin1.contabostorage.com
CONTABO_S3_BUCKET_NAME=awakencloud
CONTABO_S3_PUBLIC_BASE_URL=https://sin1.contabostorage.com/3e270ee749cc4c6caa56fcceac2c4202:awakencloud
CONTABO_S3_KEY_PREFIX=dauviendu_cloud
CONTABO_S3_ACCESS_KEY=your_contabo_s3_access_key
CONTABO_S3_SECRET_KEY=your_contabo_s3_secret_key
